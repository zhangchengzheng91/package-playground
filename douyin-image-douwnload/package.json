{
  "name": "图片下载助手",
  "displayName": "Douyin Image Download",
  "version": "0.0.2",
  "description": "Chrome extension for Douyin image download (Plasmo framework)",
  "author": "",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "antd": "^6.3.7",
    "plasmo": "0.90.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.1.40",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.8.3",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "sharp"
    ]
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "tabs",
      "scripting",
      "sidePanel",
      "storage",
      "webRequest",
      "declarativeNetRequest",
      "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Ctrl+M",
          "mac": "Ctrl+M"
        },
        "description": "打开侧边栏"
      }
    }
  }
}
